PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/expense_tracker

# Demo mode serves the existing shared sample ledger. Never deploy it publicly.
# Production must remain disabled until authenticated, per-user financial storage
# has been migrated and audited.
NODE_ENV=development
AUTH_MODE=authenticated
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Required by the planned server-side session implementation (generate with
# `node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"`).
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_COOKIE_NAME=expense.sid
SESSION_MAX_AGE_MS=604800000

# OAuth values below are issued by each provider's developer console. Keep the
# real values in server/.env or a deployment secret manager, never in Git/Vite.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/oauth/github/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/oauth/microsoft/callback
# APPLE_CLIENT_ID is the web Services ID. Apple private keys are signing secrets.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:5000/api/oauth/apple/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

WEBAUTHN_RP_NAME=Expense Tracker Pro
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
MFA_ENCRYPTION_KEY=
RECOVERY_CODE_PEPPER=
