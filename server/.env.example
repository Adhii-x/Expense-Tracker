PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/expense_tracker

# Demo mode serves the existing shared sample ledger. Never deploy it publicly.
# Production must remain disabled until authenticated, per-user financial storage
# has been migrated and audited.
NODE_ENV=development
AUTH_MODE=authenticated
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Required for persistent and predictable server-side sessions (generate with
# `node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"`).
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_COOKIE_NAME=expense.sid
SESSION_MAX_AGE_MS=604800000

# OAuth values below are issued by each provider's developer console. Keep real
# values in server/.env or a deployment secret manager, never in Git/Vite.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/oauth/github/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

WEBAUTHN_RP_NAME=Expense Tracker Pro
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
# Generate each independently with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
RECOVERY_CODE_PEPPER=
